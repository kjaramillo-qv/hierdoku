# =============================================================================
# Proyecto_Documentacion — variables de entorno (EJEMPLO)
# =============================================================================
# COPIA este archivo a `.env` y rellena los valores reales:
#
#   cp .env.example .env
#
# El `.env` real ya esta en .gitignore: NUNCA lo subas a git.
# =============================================================================

# --- Hermes (servidor de API) ------------------------------------------------
# Clave con la que el frontend autentica contra Hermes (API_SERVER_KEY).
API_SERVER_KEY=REEMPLAZA_ESTE_VALOR

# Secreto HMAC del webhook 'documentar-pipeline' que usa el frontend.
PIPELINE_WEBHOOK_SECRET=REEMPLAZA_ESTE_VALOR

# --- OmniRoute ----------------------------------------------------------------
OMNIROUTE_API_KEY=REEMPLAZA_ESTE_VALOR
OMNIROUTE_INITIAL_PASSWORD=REEMPLAZA_ESTE_VALOR
OMNIROUTE_JWT_SECRET=REEMPLAZA_ESTE_VALOR
OMNIROUTE_STORAGE_KEY=REEMPLAZA_ESTE_VALOR

# --- API keys del modelo de chat del usuario final ----------------------------
# Estas NO van aqui: el usuario final las carga desde el frontend (onboarding)
# y se guardan en secrets/user_keys.env. No las pongas en este .env.
